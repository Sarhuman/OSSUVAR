; OSSUVAR — Godot 4.7.2, somente 2D.
config_version=5

[application]
config/name="OSSUVAR"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
EventBus="*res://core/event_bus.gd"
GameState="*res://core/game_state.gd"
SaveService="*res://core/save_service.gd"
DataRegistry="*res://core/data_registry.gd"
Rng="*res://core/rng.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/min_width=1280
window/size/min_height=720
window/stretch/mode="canvas_items"

[input]

move_click={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":1)]
}

skill_right={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"button_index":2)]
}

stand_attack={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}

potion_1={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":49)]
}

potion_2={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":50)]
}

potion_3={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":51)]
}

potion_4={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":52)]
}

open_inventory={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":73)]
}

open_character={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":67)]
}

open_skills={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":83)]
}

toggle_map={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":4194306)]
}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
